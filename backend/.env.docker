AC_DB_DSN=postgresql+psycopg://db_user:db_password@postgres:5432/ac
AC_CELERY_BACKEND=valkey://valkey:6379
AC_CELERY_BROKER=amqp://guest:guest@rabbitmq:5672
AC_VERTEX_CREDENTIALS_PATH=/app/vertex_credentials.json
# For db container to create initial db/user
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=ac
